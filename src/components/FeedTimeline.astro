---
import VideoDialog from "~/components/VideoDialog.astro";
import { FEED_KIND_LABEL, type FeedMonth } from "~/lib/feed";
import { slugifyTag, tagHref } from "~/lib/tags";

interface Props {
	months: FeedMonth[];
	/** Slug of the tag being browsed, when this timeline is a tag page. Its own
	 *  chip is marked current instead of linking the reader back to here. */
	activeSlug?: string;
}

const { months, activeSlug } = Astro.props;

const dateFmt = new Intl.DateTimeFormat("en", {
	year: "numeric",
	month: "short",
	day: "numeric",
	timeZone: "UTC",
});
---

<div class="feed-stream">
	{
		months.map((month) => (
			<section class="feed-month" aria-labelledby={`m-${month.id}`}>
				<h2 class="feed-month-title mono" id={`m-${month.id}`}>
					{month.label}
				</h2>
				<ol class="feed-list">
					{month.entries.map((entry) => (
						<li class="feed-item" data-kind={entry.kind}>
							<p class="feed-meta mono">
								<span class:list={["feed-badge", `feed-badge--${entry.kind}`]}>
									{FEED_KIND_LABEL[entry.kind]}
								</span>
								<time datetime={entry.date.toISOString()}>{dateFmt.format(entry.date)}</time>
								{entry.meta && (
									<span>
										<span class="feed-sep" aria-hidden="true">
											·
										</span>
										{entry.meta}
									</span>
								)}
								{entry.tags.length > 0 && (
									<span class="feed-tags">
										<span class="feed-sep" aria-hidden="true">
											·
										</span>
										{entry.tags.map((tag, index) => {
											const slug = slugifyTag(tag);
											return (
												<>
													{index > 0 && (
														<span class="feed-tag-sep" aria-hidden="true">
															·
														</span>
													)}
													<a
														class="feed-tag"
														href={tagHref(slug)}
														{...(slug === activeSlug ? { "aria-current": "page" } : {})}
													>
														{tag}
													</a>
												</>
											);
										})}
									</span>
								)}
							</p>
							<h3 class="feed-title">
								<a
									href={entry.href}
									{...(entry.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
								>
									{entry.title}
								</a>
							</h3>
							<p class="feed-summary">{entry.summary}</p>
							{entry.points.length > 0 && (
								<ul class="feed-points">
									{entry.points.map((point) => (
										<li>{point}</li>
									))}
								</ul>
							)}
							{entry.videoId && (
								<div class="feed-watch">
									<VideoDialog
										videoId={entry.videoId}
										label="Watch here"
										title={entry.title}
										watchHref={entry.href}
									/>
								</div>
							)}
						</li>
					))}
				</ol>
			</section>
		))
	}
</div>

{/* `is:inline` keeps these rules in the page that uses them instead of the one
    shared stylesheet (`vite.build.cssCodeSplit: false`) that every route loads —
    the landing page's size-limit budget measures that file, and a blog timeline
    has no business inside it. Every selector is `feed-`-prefixed and rooted at
    `.feed-stream`, which is the scoping Astro would otherwise add. */}
<style is:inline>
	.feed-month {
		margin-top: var(--space-7);
	}
	.feed-stream .feed-month:first-child {
		margin-top: var(--space-6);
	}
	.feed-stream .feed-month-title {
		font-size: var(--text-mono);
		font-weight: 400;
		color: var(--fog-1);
		text-transform: uppercase;
		letter-spacing: var(--tracking-eyebrow);
		margin: 0;
	}
	.feed-stream .feed-list {
		list-style: none;
		padding: 0 0 0 var(--space-5);
		margin: var(--space-4) 0 0;
		border-left: 1px solid var(--hairline);
	}
	.feed-stream .feed-list > li {
		position: relative;
		margin: 0 0 var(--space-6);
	}
	.feed-stream .feed-list > li:last-child {
		margin-bottom: 0;
	}
	/* The timeline node. Colour is the second signal for the kind, after the
	   badge text — never the only one. */
	.feed-item::before {
		content: "";
		position: absolute;
		left: calc(-1 * var(--space-5) - 3px);
		top: 7px;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--fog-1);
	}
	.feed-item[data-kind="release"]::before {
		background: var(--cyan-glow);
	}
	.feed-item[data-kind="video"]::before {
		background: var(--paper);
	}
	.feed-meta {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-3);
		font-size: var(--text-mono);
		color: var(--fog-1);
		text-transform: uppercase;
		letter-spacing: var(--tracking-eyebrow);
	}
	.feed-badge {
		padding: 2px 8px;
		border-radius: var(--radius-pill);
		border: 1px solid var(--hairline-strong);
		color: var(--fog-2);
	}
	.feed-badge--release {
		color: var(--cyan-bright);
		border-color: var(--accent-border);
	}
	.feed-badge--video {
		color: var(--paper);
	}
	.feed-sep {
		margin-right: var(--space-3);
	}
	.feed-tag-sep {
		margin: 0 6px;
	}
	/* Accent-coloured rather than underlined: the meta line is tracked at 0.3em,
	   and an underline under a tracked run overshoots the last glyph by the full
	   letter-space, which reads as a typo. The underline comes back on hover. */
	.feed-stream .feed-tag {
		color: var(--cyan-core);
		text-decoration: none;
		transition: color var(--dur-base) var(--ease-out);
	}
	.feed-stream .feed-tag:hover {
		color: var(--cyan-bright);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	/* On its own tag page a tag is not somewhere to go: it drops back to the
	   colour of the meta line around it, and says so with aria-current. */
	.feed-stream .feed-tag[aria-current="page"] {
		color: var(--fog-2);
	}
	.feed-stream .feed-tag:focus-visible {
		outline: 2px solid var(--cyan-core);
		outline-offset: 2px;
	}
	.feed-stream .feed-title {
		font-size: var(--text-lg);
		font-weight: 500;
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-tight);
		margin: var(--space-2) 0 6px;
	}
	.feed-stream .feed-title a {
		color: var(--paper);
		text-decoration: none;
		transition: color var(--dur-base) var(--ease-out);
	}
	.feed-stream .feed-title a:hover {
		color: var(--cyan-core);
	}
	.feed-summary {
		font-size: var(--text-sm);
		line-height: var(--leading-snug);
		color: var(--fog-3);
		max-width: 62ch;
	}
	/* `ch` resolves against this element's own font-size — set it here, not on the
	   items, or the bullets get a wider measure than the summary above them. */
	.feed-stream .feed-points {
		list-style: none;
		padding: 0;
		margin: var(--space-3) 0 0;
		max-width: 62ch;
		font-size: var(--text-sm);
	}
	.feed-stream .feed-points li {
		position: relative;
		margin: 6px 0 0;
		padding-left: var(--space-4);
		line-height: var(--leading-snug);
		color: var(--fog-2);
	}
	.feed-stream .feed-points li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.62em;
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--accent-border);
	}
	.feed-watch {
		margin-top: var(--space-3);
	}
	.feed-watch .video-trigger {
		padding: 8px 16px;
		font-size: var(--text-sm);
	}
</style>
