---
import { type CollectionEntry, getCollection, render } from "astro:content";
import TagChips from "~/components/TagChips.astro";
import Article from "~/layouts/Article.astro";
import { collectTags } from "~/lib/tags";

// Blog posts are English-only (localized={false}) — the design-decision essays
// are written once, in the voice of the design docs they link to.
export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const kindLabel: Record<CollectionEntry<"blog">["data"]["kind"], string> = {
	decision: "Design decision",
	retrospective: "Retrospective",
	advisory: "Advisory",
	tutorial: "Tutorial",
};

// Through `collectTags` so a post's chips carry the same slugs, and the same
// spelling, as the tag pages they link to.
const tags = collectTags([{ tags: post.data.tags }]);
---

<Article
	title={post.data.title}
	description={post.data.summary}
	eyebrow={kindLabel[post.data.kind]}
	date={post.data.date}
	localized={false}
>
	<TagChips slot="tags" tags={tags} label="Filed under" />
	<Content />
	<p class="mono"><a href="/blog">← All posts</a></p>
</Article>
