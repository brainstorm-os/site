---
import FeedTimeline from "~/components/FeedTimeline.astro";
import TagChips from "~/components/TagChips.astro";
import Article from "~/layouts/Article.astro";
import {
	FEED_KIND_LABEL,
	FEED_KIND_PLURAL,
	FeedKind,
	buildFeed,
	countByKind,
	groupByMonth,
} from "~/lib/feed";
import { collectTags } from "~/lib/tags";

const entries = await buildFeed();
const months = groupByMonth(entries);
const counts = countByKind(entries);
const tags = collectTags(entries);

const streams = Object.values(FeedKind).filter((kind) => counts[kind] > 0);

// Only offer a chip for a stream that has entries — an empty filter is a dead
// control.
const filters = [
	{ id: "all", label: "Everything" },
	...streams.map((kind) => ({ id: kind, label: `${FEED_KIND_LABEL[kind]}s` })),
];

const countLine = streams.map((kind) => `${counts[kind]} ${FEED_KIND_PLURAL[kind]}`).join(" · ");
---

<Article
	title="Blog"
	description="Everything Brainstorm publishes, in one timeline — design decisions, retrospectives, every release, and the demo videos."
	eyebrow="Writing"
	localized={false}
>
	<div class="feed">
		<div class="feed-bar">
			<p class="feed-count mono">{countLine}</p>
			<a class="feed-rss mono" href="/blog/rss.xml">RSS feed</a>
		</div>

		<div class="feed-controls">
			<div class="feed-filter" role="group" aria-label="Filter the timeline by kind">
				{
					filters.map((filter, index) => (
						<>
							<input
								class="feed-radio"
								type="radio"
								name="feed-kind"
								id={`feed-${filter.id}`}
								checked={index === 0}
							/>
							<label class="feed-chip" for={`feed-${filter.id}`}>
								{filter.label}
							</label>
						</>
					))
				}
			</div>

			<div class="feed-topics">
				<TagChips tags={tags} label="Topics" countInLabel>
					<a class="tag-chip tag-chip--more" href="/blog/tags">All topics</a>
				</TagChips>
			</div>
		</div>

		<FeedTimeline months={months} />
	</div>
</Article>

{/* `is:inline` keeps these rules in this page instead of the one shared
    stylesheet (`vite.build.cssCodeSplit: false`) that every route loads — the
    landing page's size-limit budget measures that file, and a blog timeline has
    no business inside it. Every selector is `feed-`-prefixed and rooted at
    `.feed`, which is the scoping Astro would otherwise add. */}
<style is:inline>
	.feed-bar {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
	}
	.feed-count,
	.feed .feed-rss {
		font-size: var(--text-mono);
		color: var(--fog-1);
		text-transform: uppercase;
		letter-spacing: var(--tracking-eyebrow);
		text-decoration: none;
	}
	.feed .feed-rss:hover {
		color: var(--cyan-core);
	}

	.feed-controls {
		margin-top: var(--space-4);
		padding-bottom: var(--space-5);
		border-bottom: 1px solid var(--hairline);
	}
	.feed-filter {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	/* Kept in the layout rather than `hidden` so the group stays keyboard
	   reachable — the filter is CSS-only and must work with JavaScript off. */
	.feed-radio {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}
	.feed-chip {
		padding: 6px 14px;
		border-radius: var(--radius-pill);
		border: 1px solid var(--hairline-strong);
		font-size: var(--text-xs);
		color: var(--fog-2);
		cursor: pointer;
		transition:
			border-color var(--dur-base) var(--ease-out),
			color var(--dur-base) var(--ease-out);
	}
	.feed-chip:hover {
		color: var(--paper);
		border-color: var(--cyan-glow);
	}
	.feed-radio:checked + .feed-chip {
		color: var(--paper);
		border-color: var(--cyan-glow);
		background: var(--accent-soft);
	}
	.feed-radio:focus-visible + .feed-chip {
		outline: 2px solid var(--cyan-core);
		outline-offset: 2px;
	}

	/* Second row: the topics a reader can browse into, alongside the kind filter
	   so both ways of narrowing the timeline are visible at once. */
	.feed-topics {
		margin-top: var(--space-4);
	}

	/* CSS-only stream filter: `:has()` reads the checked radio, so filtering needs
	   no JavaScript and the page still renders whole with JavaScript disabled. A
	   month left with nothing in it hides its heading too. */
	.feed:has(#feed-article:checked) .feed-item:not([data-kind="article"]),
	.feed:has(#feed-release:checked) .feed-item:not([data-kind="release"]),
	.feed:has(#feed-video:checked) .feed-item:not([data-kind="video"]) {
		display: none;
	}
	.feed:has(#feed-article:checked) .feed-month:not(:has([data-kind="article"])),
	.feed:has(#feed-release:checked) .feed-month:not(:has([data-kind="release"])),
	.feed:has(#feed-video:checked) .feed-month:not(:has([data-kind="video"])) {
		display: none;
	}
</style>
